/* LLM Command Center — design tokens */

/* Surfaces (low → high) */
$bg: #0a0d12;
$bg-elevated: #141923;
$surface: #1d2433;
$surface-hi: #29334a;

/* Lines */
$border: #2a313c;
$border-strong: #3d4757;

/* Text (loud → quiet) */
$text: #d7dde6;
$text-dim: #8b95a5;
$text-faint: #5d6573;

/* Brand & accent */
$brand: #8b9eff;
$accent: #8b9eff;
$accent-soft: #1f2540;

/* Semantic + soft companion */
$ok: #4ade80;
$ok-soft: #14291f;
$warn: #fbbf24;
$warn-soft: #2c2114;
$err: #f87171;
$err-soft: #2e1719;
$info: #60a5fa;

Screen {
    background: $bg;
}

/* --- Branded header (single line) --- */

#board-header {
    dock: top;
    height: 1;
    background: $bg;
    padding: 0 2;
    border-bottom: hkey $border;
}

#board-brand {
    width: auto;
    color: $text;
    background: $bg;
}

#board-stats {
    width: 1fr;
    text-align: right;
    color: $text-dim;
    background: $bg;
}

/* --- Kanban --- */

#kanban-board {
    height: 1fr;
    background: $bg;
}

KanbanColumn {
    width: 1fr;
    height: 100%;
    padding: 0 1;
    background: $bg;
}

KanbanColumn.-active {
    background: $bg-elevated;
}

.column-header {
    height: 1;
    color: $text-dim;
    text-style: bold;
    padding: 0;
}

KanbanColumn.-active .column-header {
    color: $brand;
}

.column-meta {
    height: 1;
    color: $text-faint;
    padding: 0;
    display: none;
}

KanbanColumn.-active .column-meta {
    display: block;
}

.column-empty {
    height: auto;
    color: $text-faint;
    padding: 1 1;
    text-align: center;
}

#first-launch {
    dock: top;
    height: auto;
    background: $bg-elevated;
    border: round $accent;
    padding: 1 2;
    margin: 1 4;
    text-align: center;
    color: $text;
}

/* --- Task cards (neutral surface; status conveyed via in-text glyph) --- */

TaskCard {
    height: auto;
    min-height: 3;
    max-height: 10;
    margin: 0 0 1 0;
    padding: 1 2;
    background: $surface;
    color: $text;
}

/* Stale tasks (active stage, no live session) get a subtler dim. */
TaskCard.-stale {
    color: $text-dim;
}

/* Selection: lift the surface — no border, no layout shift. */
TaskCard.-selected {
    background: $surface-hi;
}

/* --- Task input dialog --- */

TaskInputDialog {
    align: center middle;
}

#task-input-container {
    width: 80;
    height: auto;
    max-height: 90%;
    background: $bg-elevated;
    border: round $border-strong;
    padding: 1 2;
}

#task-input-title {
    height: 1;
    color: $text;
    margin: 0;
}

#task-input-hint {
    height: 1;
    color: $text-dim;
    margin: 0 0 1 0;
    border-bottom: hkey $border;
    padding: 0 0 1 0;
}

#task-input-form {
    height: 1fr;
    background: $bg-elevated;
}

#task-input-container Label {
    color: $text-dim;
    height: 1;
    margin: 1 0 0 0;
    padding: 0;
}

#task-input-container Input {
    margin: 0;
    border: round $border;
    background: $bg;
}

#task-input-container Input:focus {
    border: round $accent;
}

#task-input-container TextArea {
    height: 5;
    margin: 0;
    border: round $border;
    background: $bg;
}

#task-input-container TextArea.-focus {
    border: round $accent;
}

#task-input-container .form-error {
    height: auto;
    color: $err;
    padding: 0 1;
    margin: 0;
}

#task-input-container #task-desc {
    height: 8;
}

#task-input-buttons {
    dock: bottom;
    height: 5;
    align: right middle;
    padding: 1 0 0 0;
    border-top: hkey $border;
    background: $bg-elevated;
}

#task-input-buttons Button {
    min-width: 12;
    margin: 0 0 0 1;
}

/* --- Help screen --- */

HelpScreen {
    align: center middle;
}

#help-container {
    width: 70;
    height: 80%;
    background: $bg-elevated;
    border: round $border-strong;
    padding: 1 2;
}

#help-title {
    height: 1;
    color: $text;
    margin: 0;
}

#help-hint {
    height: 1;
    color: $text-dim;
    margin: 0 0 1 0;
    border-bottom: hkey $border;
    padding: 0 0 1 0;
}

#help-container VerticalScroll {
    height: 1fr;
    background: $bg-elevated;
}

#help-body {
    color: $text;
    padding: 0 1;
}

/* --- Confirm dialog (severity-aware) --- */

ConfirmDialog {
    align: center middle;
}

#confirm-container {
    width: 50;
    height: auto;
    background: $bg-elevated;
    border: round $border-strong;
    padding: 1 2;
}

#confirm-container.-warning {
    border: round $warn;
}

#confirm-container.-danger {
    border: round $err;
}

#confirm-buttons {
    height: 3;
    margin: 1 0 0 0;
}

#confirm-buttons Button {
    width: 1fr;
    margin: 0 1;
}

/* --- Tabs --- */

TabbedContent {
    height: 1fr;
}

TabbedContent ContentSwitcher {
    height: 1fr;
}

TabPane {
    padding: 0;
    height: 1fr;
}

/* --- Agent panel --- */

AgentPanelView {
    width: 1fr;
    height: 1fr;
    background: $bg;
    padding: 0;
}

AgentPanelView .agent-titlebar {
    dock: top;
    height: 1;
    color: $text-faint;
    background: $bg;
    padding: 0 1;
    border-bottom: hkey $border;
}

AgentPanelView:focus-within .agent-titlebar {
    color: $text-dim;
    border-bottom: hkey $border-strong;
}

AgentPanelView .agent-scroll {
    height: 1fr;
    padding: 0 1;
    background: $bg;
}

AgentPanelView .agent-output {
    color: $text-dim;
}

AgentPanelView:focus-within .agent-output {
    color: $text;
}

AgentPanelView .agent-status {
    dock: bottom;
    height: 1;
    color: $text;
    background: $bg-elevated;
    padding: 0 1;
    border-top: hkey $border;
}

AgentPanelView .agent-help {
    dock: bottom;
    height: 1;
    color: $text-dim;
    background: $bg-elevated;
    padding: 0 1;
    border-top: hkey $border;
}

AgentPanelView .agent-input {
    dock: bottom;
    margin: 0;
    border: round $accent;
    background: $bg-elevated;
}

AgentPanelView .agent-pause {
    dock: bottom;
    height: 1;
    color: $warn;
    background: $warn-soft;
    padding: 0 1;
    text-align: center;
}

AgentPanelView .agent-prompt-banner {
    dock: top;
    height: 1;
    color: $warn;
    background: $warn-soft;
    padding: 0 1;
    text-align: center;
}

/* --- Diff view --- */

DiffView {
    align: center middle;
}

#diff-view {
    width: 90%;
    height: 80%;
    background: $bg-elevated;
    border: round $accent;
    padding: 1 1 0 1;
}

#diff-header {
    dock: top;
    height: 1;
    color: $text-dim;
    padding: 0 1;
    border-bottom: hkey $border;
}

#diff-content {
    color: $text;
}

/* --- Toasts --- */

Toast {
    background: $bg-elevated;
    border: round $border-strong;
    padding: 0 1;
}

Toast.-information {
    border: round $info;
}

Toast.-warning {
    border: round $warn;
}

Toast.-error {
    border: round $err;
}

/* --- Footer --- */

Footer {
    dock: bottom;
    background: $bg-elevated;
    color: $text-dim;
}
